@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix edintcom: <https://edint.es/def/censo-locales#> .
@prefix edintkoacctype: <https://edint.es/kos/AccesType/> .
@prefix edintkoscomespsit: <https://edint.es/kos/CommercialSpaceStatus/> .
@prefix edintkosinf: <https://edint.es/kos/InfrastructureType/> .
@prefix edintterper: <https://edint.es/kos/TerracePeriod/> .
@prefix edintinf: <https://edint.es/def/infraestructura#> .
@prefix esdir: <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/direccion-postal#> .
@prefix ex: <https://example.org/recurso/> .
@prefix fnml: <http://semweb.mmlab.be/ns/fnml#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix formats: <http://www.w3.org/ns/formats/> .
@prefix geosparql: <http://www.opengis.net/ont/geosparql#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:AGR-0001 a
    edintcom:CommercialAggregation;
  dcterms:identifier "AGR-0001";
  rdfs:comment "Mercado tradicional de Madrid, con origen en 1876 y reinaugurado en 1943 tras una reforma. Tiene accesos por Alonso Cano, García de Paredes y Viriato, y combina puestos de alimentación, restauración y comercio especializado.";
  rdfs:label "Mercado de Chamberí" .

ex:28010 a esdir:DireccionPostal;
  schema:postalCode "28010";
  rdfs:label "28010" .

ex:ENT-0001 a edintcom:CommercialEntity;
  dcterms:identifier "ENT-0001";
  schema:legalName "Cafetería Chamberí S.L.";
  schema:url "https://mercadodechamberi.es";
  edintcom:hasCNAECode <http://lod.ine.es/kos/cnae/CNAE-2025/6/563000>;
  edintcom:hasIAECode <https://edint.es/kos/iae/3/673.1>;
  edintcom:usesSpace ex:COM-0001;
  rdfs:label "Cafetería Chamberí S.L." .

ex:COM-0001 a edintcom:CommercialSpace;
  dcterms:identifier "COM-0001";
  edintcom:belongsToCommercialAggregation ex:AGR-0001;
  edintcom:hasAccessType edintkoacctype:Indoor;
  edintcom:hasCommercialSpaceStatus edintkoscomespsit:Active;
  edintcom:hasTerrace ex:TER-0001;
  rdfs:label "Cafetería Chamberí" .

ex:TER-0001 a edintcom:Terrace;
  dcterms:identifier "TER-0001";
  schema:address ex:28010;
  schema:floorSize "14.5";
  schema:maximumAttendeeCapacity 18;
  schema:openingHours "Tu-Sa 12:30-16:30; Tu-Sa 19:00-00:00; Su 12:30-16:30";
  edintcom:hasTerracePeriod edintterper:anual;
  edintcom:numeroMesasAutorizadas 6;
  edintcom:numeroSillasAutorizadas 18;
  edintinf:belongsTo ex:TRAFALGAR;
  edintinf:hasInfrastructureType edintkosinf:Terrace;
  geosparql:hasGeometry ex:TER-0001-geometry;
  rdfs:comment "Zona de degustación vinculada a cafetería-pastelería dentro del Mercado de Chamberí, orientada a consumo en horario diurno y de restauración.";
  rdfs:label "Terraza Cafetería Chamberí" .

ex:TER-0001-geometry geosparql:asWKT
    "POINT (-3.700200 40.434300)"^^geosparql:wktLiteral .

ex:LIC-CAF-0001 a edintcom:Permit ;
  dcterms:identifier "LIC-CAF-0001" ;
  rdfs:label "Licencia de actividad Cafetería Chamberí" ;
  edintcom:fileCode "2021/EXP/45872" ;
  edintcom:issuedTo ex:ENT-0001 ;
  edintcom:appliedTo ex:COM-0001 ;
  edintcom:hasCommercialPermitType <https://edint.es/kos/CommercialPermitType/APAL> ;
  edintcom:hasCommercialPermitStatus <https://edint.es/kos/CommercialPermitStatus/Granted> ;
  edintcom:hasCNAECode <http://lod.ine.es/kos/cnae/CNAE-2025/6/563000> ;
  edintcom:hasIAECode <https://edint.es/kos/iae/3/673.1> ;
  schema:startDate "2021-05-14T00:00:00"^^xsd:dateTime .

ex:LIC-TER-0001 a edintcom:Permit ;
  dcterms:identifier "LIC-TER-0001" ;
  rdfs:label "Autorización de terraza Cafetería Chamberí" ;
  edintcom:fileCode "2024/VEL/10328" ;
  edintcom:appliedTo ex:TER-0001 ;
  edintcom:hasCommercialPermitType <https://edint.es/kos/CommercialPermitType/APAL> ;
  edintcom:hasCommercialPermitStatus <https://edint.es/kos/CommercialPermitStatus/Granted> ;
  schema:startDate "2024-03-01T00:00:00"^^xsd:dateTime ;
  schema:endDate "2026-12-31T23:59:59"^^xsd:dateTime .
